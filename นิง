-- ฟังก์ชันสร้าง Slider พร้อมช่องป้อนตัวเลข (TextBox)
local function createSliderWithBox(parent, title, minVal, maxVal, defaultVal, callback)
    local sliderFrame = Instance.new("Frame")
    sliderFrame.Size = UDim2.new(1, -6, 0, 48)
    sliderFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
    sliderFrame.Parent = parent

    local sliderCorner = Instance.new("UICorner")
    sliderCorner.CornerRadius = UDim.new(0, 6)
    sliderCorner.Parent = sliderFrame

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -65, 0, 20)
    titleLabel.Position = UDim2.new(0, 8, 0, 4)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title
    titleLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
    titleLabel.TextSize = 13
    titleLabel.Font = Enum.Font.SourceSansBold
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = sliderFrame

    -- ช่องกรอกเลขสำหรับคนไม่อยากเลื่อน
    local valBox = Instance.new("TextBox")
    valBox.Size = UDim2.new(0, 50, 0, 18)
    valBox.Position = UDim2.new(1, -58, 0, 4)
    valBox.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
    valBox.Text = tostring(defaultVal)
    valBox.TextColor3 = Color3.fromRGB(255, 215, 0)
    valBox.TextSize = 12
    valBox.Font = Enum.Font.SourceSansBold
    valBox.ClearTextOnFocus = false
    valBox.Parent = sliderFrame

    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 4)
    boxCorner.Parent = valBox

    local barBackground = Instance.new("Frame")
    barBackground.Size = UDim2.new(1, -16, 0, 6)
    barBackground.Position = UDim2.new(0, 8, 0, 32)
    barBackground.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    barBackground.Parent = sliderFrame

    local bgCorner = Instance.new("UICorner")
    bgCorner.CornerRadius = UDim.new(1, 0)
    bgCorner.Parent = barBackground

    local fillBar = Instance.new("Frame")
    local initRatio = math.clamp((defaultVal - minVal) / (maxVal - minVal), 0, 1)
    fillBar.Size = UDim2.new(initRatio, 0, 1, 0)
    fillBar.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
    fillBar.Parent = barBackground

    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(1, 0)
    fillCorner.Parent = fillBar

    local function setValue(val)
        val = math.clamp(val, minVal, maxVal)
        valBox.Text = tostring(val)
        local ratio = (val - minVal) / (maxVal - minVal)
        fillBar.Size = UDim2.new(ratio, 0, 1, 0)
        callback(val)
    end

    local dragging = false
    local function updateSlider(input)
        local pos = math.clamp((input.Position.X - barBackground.AbsolutePosition.X) / barBackground.AbsoluteSize.X, 0, 1)
        local value = math.floor(minVal + (maxVal - minVal) * pos)
        setValue(value)
    end

    sliderFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateSlider(input)
        end
    end)
    userInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateSlider(input)
        end
    end)
    userInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- เมื่อพิมพ์ตัวเลขลงในช่องแล้วกด Enter / คลิกที่อื่น
    valBox.FocusLost:Connect(function()
        local num = tonumber(valBox.Text)
        if num then
            setValue(math.floor(num))
        else
            valBox.Text = tostring(minVal)
            setValue(minVal)
        end
    end)
end

